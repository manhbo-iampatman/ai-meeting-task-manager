# Sao chép file này thành ".env" rồi điền giá trị thật.
# File .env đã nằm trong .gitignore — không bị đẩy lên Git.

APP_NAME=MeetFlow
DEBUG=true

# Khớp với docker-compose.yml
DATABASE_URL=postgresql+psycopg://meetflow:meetflow@localhost:5433/meetflow
REDIS_URL=redis://localhost:6379/0

# Bảo mật JWT: BẮT BUỘC đổi thành chuỗi ngẫu nhiên ≥ 32 ký tự, để nguyên thì backend từ chối chạy.
# Tạo bằng:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien
CORS_ORIGINS=http://localhost:5173

# Thư mục lưu file ghi âm upload
UPLOAD_DIR=uploads

# ---- AI ----
# STT_PROVIDER: local (faster-whisper trên máy) | groq (API)
STT_PROVIDER=local
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_MODEL_DIR=models_cache

# LLM_PROVIDER: gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Mô hình chính quá tải / hết hạn mức (429, 503, 504, hết thời gian chờ) → tự chuyển sang mô hình này.
# Để trống = không dùng dự phòng.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Số token Ollama đọc mỗi lần gọi; bản ghi dài hơn sẽ tự chia đoạn
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30s
# Nhiệt độ sinh chữ (thấp = kết quả ổn định giữa các lần chạy)
LLM_TEMPERATURE=0.2
# Chờ Gemini tối đa bao nhiêu giây cho mỗi lần gọi (bình thường 3–20 giây; quá ngưỡng = coi như quá tải)
LLM_TIMEOUT_SEC=60
# Giới hạn ký tự mỗi đoạn khi chia bản ghi dài (0 = mặc định theo mô hình)
LLM_CHUNK_CHARS=0
GROQ_API_KEY=

# ---- Phòng họp trực tuyến "Online Meeting" (LiveKit, Giai đoạn 6) ----
# Chạy `python scripts/setup_lan.py` để tự điền 2 khóa dưới đây (trùng với file .env ở thư mục gốc
# mà Docker Compose đọc). Để nguyên mặc định thì dùng cặp khóa dev có sẵn trong docker-compose.yml.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=meetflow-dev-secret-chi-dung-tren-may-minh-0123456789
ROOM_MAX_PARTICIPANTS=6
# Mọi người rời hết quá bấy nhiêu giây thì tự đóng phòng
ROOM_EMPTY_CLOSE_SEC=30
# Phòng vừa tạo mà không ai vào được (lỗi kết nối…): đóng sau bấy nhiêu giây
ROOM_UNJOINED_CLOSE_SEC=60
# Chủ phòng vắng quá bấy nhiêu giây trong khi phòng còn người → nhượng quyền cho người vào sớm nhất
ROOM_HOST_ABSENT_SEC=60
# Phòng kết thúc: chờ ghi âm của mọi người tối đa bấy nhiêu giây rồi nhận dạng với phần đã có
ROOM_UPLOAD_WAIT_SEC=120
